# doXQ environment configuration — copy to `.env` and fill in real values.
# The real `.env` is git-ignored; never commit actual credentials.

# --- MongoDB Atlas (data store) ---
# Get this from Atlas: Database > Connect > Drivers. Replace <user>/<password>.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
MONGODB_DB="doxq_db"

# --- Web session signing ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET="change-me-to-a-long-random-string"
